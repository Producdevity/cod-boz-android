root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,c}]
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{sh,md,yml,yaml,txt,toml,xml,gradle,pro}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
