<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#202428" />
            <stroke android:width="1dp" android:color="#505860" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111315" />
            <stroke android:width="1dp" android:color="#343A3F" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
