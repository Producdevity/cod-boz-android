<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <dev.producdevity.codboz.LauncherBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideInset">

        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="30dp"
            android:paddingBottom="34dp">

            <Button
                android:id="@+id/back_button"
                style="@style/Widget.CodBoz.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="8dp"
                android:text="@string/back" />

            <TextView
                style="@style/TextAppearance.CodBoz.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/runtime_eyebrow" />

            <TextView
                style="@style/TextAppearance.CodBoz.Display.Settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/game_settings" />

            <TextView
                style="@style/TextAppearance.CodBoz.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/settings_intro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.CodBoz.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_name" />

                <EditText
                    android:id="@+id/settings_player_name"
                    style="@style/Widget.CodBoz.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp"
                    android:hint="@string/player_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:maxLength="13"
                    android:maxLines="1" />

                <TextView
                    style="@style/TextAppearance.CodBoz.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/player_name_rules" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.CodBoz.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/online_play" />

                        <TextView
                            style="@style/TextAppearance.CodBoz.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/online_play_detail" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/online_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:button="@null"
                        android:showText="false"
                        android:thumbTint="@drawable/switch_thumb"
                        android:trackTint="@drawable/switch_track" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.CodBoz.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/multiplayer_server" />

                <EditText
                    android:id="@+id/multiplayer_server"
                    style="@style/Widget.CodBoz.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp"
                    android:hint="@string/server_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1" />

                <TextView
                    style="@style/TextAppearance.CodBoz.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/server_rules" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/test_connection_button"
                        style="@style/Widget.CodBoz.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/test_connection" />

                    <Button
                        android:id="@+id/restore_server_button"
                        style="@style/Widget.CodBoz.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/restore_default" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.CodBoz.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_chat" />

                    <TextView
                        style="@style/TextAppearance.CodBoz.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/voice_chat_detail" />
                </LinearLayout>

                <Switch
                    android:id="@+id/voice_chat_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:button="@null"
                    android:showText="false"
                    android:thumbTint="@drawable/switch_thumb"
                    android:trackTint="@drawable/switch_track" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_status"
                style="@style/TextAppearance.CodBoz.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:text="@string/settings_apply_note" />

            <Button
                android:id="@+id/save_settings_button"
                style="@style/Widget.CodBoz.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/save_settings" />

            <TextView
                style="@style/TextAppearance.CodBoz.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/config_file" />

            <TextView
                style="@style/TextAppearance.CodBoz.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/config_file_detail" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/import_config_button"
                    style="@style/Widget.CodBoz.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/import_config" />

                <Button
                    android:id="@+id/export_config_button"
                    style="@style/Widget.CodBoz.SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/export_config" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
